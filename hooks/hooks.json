{
  "description": "Load Ponytail, render Craft's catalog, and reject malformed Craft command shapes.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/hooks/session_start.py\"",
            "timeout": 5,
            "statusMessage": "Loading Craft...",
            "additionalContextLimit": 3000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/hooks/spec_build_gate.py\"",
            "timeout": 5,
            "statusMessage": "Routing Craft prompt...",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
