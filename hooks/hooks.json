{
  "description": "Load Craft's Ponytail policy and guard explicit Plan, Spec, and Build phases.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/hooks/session_start.py\"",
            "timeout": 5,
            "statusMessage": "Loading Craft...",
            "additionalContextLimit": 3000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/hooks/spec_build_gate.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/hooks/spec_build_gate.py\"",
            "timeout": 5,
            "statusMessage": "Checking Craft phase...",
            "additionalContextLimit": 500
          }
        ]
      }
    ]
  }
}
